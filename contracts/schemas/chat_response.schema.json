        "kind": {
          "enum": [
            "public_record",
            "case",
            "warning",
            "action",
            "ai_suggestion",
            "web",
            "user_input",
            "not_found",
            "unknown",
            "notice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
