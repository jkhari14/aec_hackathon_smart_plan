   "ChatAnswer": {
    "properties": {
     "mode": {
      "type": "string",
      "enum": [
       "live",
       "saved",
       "unavailable"
      ],
      "title": "Mode",
      "description": "live: a model answered now. saved: an example written ahead of time, checked against this brief. unavailable: no live answer; `examples` lists what can be opened."
     },
     "question": {
      "type": "string",
      "title": "Question"
     },
     "parts": {
      "items": {
       "oneOf": [
        {
         "$ref": "#/components/schemas/RecordPart"
        },
        {
         "$ref": "#/components/schemas/LeadPart"
        },
        {
         "$ref": "#/components/schemas/NotFoundPart"
        },
        {
         "$ref": "#/components/schemas/UnknownPart"
        },
        {
         "$ref": "#/components/schemas/NoticePart"
        }
       ],
       "discriminator": {
        "propertyName": "kind",
        "mapping": {
         "lead": "#/components/schemas/LeadPart",
         "not_found": "#/components/schemas/NotFoundPart",
         "notice": "#/components/schemas/NoticePart",
         "record": "#/components/schemas/RecordPart",
         "unknown": "#/components/schemas/UnknownPart"
        }
       }
      },
      "type": "array",
      "title": "Parts"
     },
     "plain_text": {
      "type": "string",
      "title": "Plain Text",
      "description": "The parts as one text, each prefixed by where it came from. For a voice client."
     },
     "as_of": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     },
     "web_search": {
      "type": "string",
      "enum": [
       "used",
       "not_used",
       "off_as_of",
       "off"
      ],
      "title": "Web Search"
     },
     "examples": {
      "items": {
       "$ref": "#/components/schemas/ExampleQuestion"
      },
      "type": "array",
      "title": "Examples"
     },
     "usage": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/ChatUsage"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "mode",
     "question",
     "parts",
     "plain_text",
     "web_search"
    ],
    "title": "ChatAnswer"
   },
   "ChatRequest": {
    "properties": {
     "slug": {
      "type": "string",
      "maxLength": 80,
      "title": "Slug"
     },
     "project_type": {
      "type": "string",
      "enum": [
       "new_building",
       "renovation",
       "excavation_next_to_existing"
      ],
      "title": "Project Type",
      "default": "excavation_next_to_existing"
     },
     "as_of": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of",
      "description": "The page's as-of day: nothing dated on or after it is used."
     },
     "history": {
      "items": {
       "$ref": "#/components/schemas/Exchange"
      },
      "type": "array",
      "maxItems": 8,
      "title": "History"
     },
     "question": {
      "type": "string",
      "maxLength": 1000,
      "title": "Question",
      "default": ""
     },
     "example_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 60
       },
       {
        "type": "null"
       }
      ],
      "title": "Example Id",
      "description": "Ask for a saved example instead of a live answer."
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "slug"
    ],
    "title": "ChatRequest",
    "description": "Over any limit the request is refused (HTTP 422), never cut to fit."
   },
   "ChatSetup": {
    "properties": {
     "live": {
      "type": "boolean",
      "title": "Live"
     },
     "examples": {
      "items": {
       "$ref": "#/components/schemas/ExampleQuestion"
      },
      "type": "array",
      "title": "Examples"
     },
     "max_question_chars": {
      "type": "integer",
