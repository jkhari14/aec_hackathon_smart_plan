{
 "openapi": "3.1.0",
 "info": {
  "title": "PreFlight",
  "version": "0.1.0"
 },
 "paths": {
  "/api/chat/setup/{slug}": {
   "get": {
    "tags": [
     "chat"
    ],
    "summary": "Chat Setup",
    "operationId": "chat_setup_api_chat_setup__slug__get",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Slug"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChatSetup"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/chat/answer": {
   "post": {
    "tags": [
     "chat"
    ],
    "summary": "Chat Answer",
    "description": "A question about one site, answered from its brief and web search. See jahleel/api/chat/README.md.",
    "operationId": "chat_answer_api_chat_answer_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ChatRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChatAnswer"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/briefs": {
   "get": {
    "summary": "Briefs",
    "operationId": "briefs_api_briefs_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/BriefListing"
         },
         "type": "array",
         "title": "Response Briefs Api Briefs Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/briefs/{slug}": {
   "get": {
    "summary": "Brief",
    "operationId": "brief_api_briefs__slug__get",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Slug"
      }
     },
     {
      "name": "project_type",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "new_building",
        "renovation",
        "excavation_next_to_existing"
       ],
       "type": "string",
       "default": "excavation_next_to_existing",
       "title": "Project Type"
      }
     },
     {
      "name": "as_of",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "description": "Build the checklist from records dated before this day.",
       "title": "As Of"
      },
      "description": "Build the checklist from records dated before this day."
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Brief"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
